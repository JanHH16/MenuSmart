  "info": {
    "title": "MenuSmart API",
    "description": "API principal de MenuSmart: autenticaciÃ³n, normalizaciÃ³n de ingredientes y comparaciÃ³n de precios entre supermercados.",
    "version": "0.2.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "ProfileDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "name",
          "createdAt"
        ]
      },
      "DeleteAccountDto": {
        "type": "object",
        "properties": {
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 72,
            "description": "ContraseÃ±a actual: confirma que quien borra la cuenta es su dueÃ±o"
          }
        },
        "required": [
          "password"
        ]
      },
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "format": "email",
            "example": "ana@correo.cl"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 72,
            "pattern": "[A-Za-z]",
            "description": "Entre 8 y 72 caracteres, con al menos una letra y un nÃºmero"
          },
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100,
            "example": "Ana"
          }
        },
        "required": [
          "email",
          "password",
          "name"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "format": "email",
            "example": "ana@correo.cl"
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 72
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "RawIngredientDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "quantity": {
            "type": "number",
            "minimum": 1
          },
          "unit": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name",
          "quantity",
          "unit"
        ]
      },
      "NormalizeIngredientsDto": {
        "type": "object",
        "properties": {
          "ingredients": {
            "minItems": 1,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RawIngredientDto"
            }
          }
        },
        "required": [
          "ingredients"
        ]
      },
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "passwordHash": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "passwordHash",
          "name",
          "createdAt"
        ]
      },
      "Comida": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "usuario": {
            "$ref": "#/components/schemas/User"
          },
          "usuarioId": {
            "type": "string"
          },
          "nombre": {
            "type": "string"
          },
          "tipo": {
            "type": "string"
          },
          "diaSemana": {
            "type": "string"
          },
          "semana": {
            "type": "string"
          },
          "porciones": {
            "type": "number"
          },
          "notas": {
            "type": "string",
            "nullable": true
          },
          "ingredientes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Ingrediente"
            }
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "usuario",
          "usuarioId",
          "nombre",
          "tipo",
          "diaSemana",
          "semana",
          "porciones",
          "notas",
          "ingredientes",
          "createdAt"
        ]
      },
      "EjecucionScraping": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "tienda": {
            "type": "string"
          },
          "estado": {
            "type": "string"
          },
          "iniciadaEn": {
            "format": "date-time",
            "type": "string"
          },
          "finalizadaEn": {
            "format": "date-time",
            "type": "string",
            "nullable": true
          },
          "consultasTotal": {
            "type": "number"
          },
          "consultasOk": {
            "type": "number"
          },
          "consultasFallidas": {
            "type": "number"
          },
          "registrosExtraidos": {
            "type": "number"
          },
          "registrosValidos": {
            "type": "number"
          },
          "registrosDuplicados": {
            "type": "number"
          },
          "registrosDescartados": {
            "type": "number"
          },
          "descartesPorMotivo": {
            "type": "object",
            "additionalProperties": {
              "type": "number"
