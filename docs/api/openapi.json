            "type": "number",
            "minimum": 1,
            "maximum": 50
          },
          "notas": {
            "type": "string",
            "maxLength": 500
          },
          "ingredientes": {
            "maxItems": 50,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/IngredienteDto"
