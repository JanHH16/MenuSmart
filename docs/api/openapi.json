          },
          "errores": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "duracionMs": {
            "type": "number",
            "nullable": true
          }
        },
        "required": [
          "id",
          "tienda",
          "estado",
          "iniciadaEn",
          "finalizadaEn",
          "consultasTotal",
          "consultasOk",
          "consultasFallidas",
          "registrosExtraidos",
          "registrosValidos",
          "registrosDuplicados",
          "registrosDescartados",
          "descartesPorMotivo",
          "errores",
          "duracionMs"
        ]
      },
      "PrecioSupermercado": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "producto": {
            "$ref": "#/components/schemas/Producto"
          },
          "productoId": {
            "type": "string"
          },
          "supermercado": {
            "type": "string"
          },
          "precio": {
            "type": "number"
          },
          "fechaObtencion": {
            "format": "date-time",
