        "required": [
          "id",
          "producto",
          "productoId",
          "supermercado",
          "precio",
          "fechaObtencion",
          "fechaDia",
          "consulta",
          "precioUnitario",
          "disponible",
          "urlProducto",
          "ejecucion",
          "ejecucionId"
        ]
      },
      "Producto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "slug": {
            "type": "string",
            "nullable": true
