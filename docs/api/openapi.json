          },
          "fechaDia": {
            "type": "string"
          },
          "consulta": {
            "type": "string"
          },
          "precioUnitario": {
            "type": "number",
            "nullable": true
          },
          "disponible": {
            "type": "boolean"
          },
          "urlProducto": {
            "type": "string",
            "nullable": true
          },
          "ejecucion": {
            "nullable": true,
            "type": "object",
            "allOf": [
