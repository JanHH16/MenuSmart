PORT=8000

# Scraper de precios (todos opcionales, estos son los valores por defecto)
# Identifica al bot ante las tiendas. Usa una URL del proyecto, no datos personales.
SCRAPER_USER_AGENT=MenuSmartBot/1.0 (+https://github.com/JanHH16/MenuSmart)
# Segundos minimos entre solicitudes a una misma tienda
SCRAPER_MIN_INTERVAL_SECONDS=1.0
SCRAPER_TIMEOUT_SECONDS=10
SCRAPER_MAX_RETRIES=2
