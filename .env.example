# Variables usadas por docker-compose.yml para orquestar todos los servicios.
# Copiar a ".env" y completar con valores reales (nunca commitear el .env real).

# DATABASE_HOST y DATABASE_PORT solo hacen falta para correr el backend o las
# migraciones fuera de Docker Compose (dentro de Compose, el backend se
# conecta al servicio "database" directamente). Con Docker Compose, la base
# queda expuesta en el puerto 5433 del host (ver docker-compose.yml).
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_USER=menusmart
DATABASE_PASSWORD=changeme
DATABASE_NAME=menusmart

JWT_SECRET=changeme
JWT_EXPIRES_IN=3600s
