# Servidor
PORT=3000
NODE_ENV=development

# Base de datos PostgreSQL
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_USER=menusmart
DATABASE_PASSWORD=changeme
DATABASE_NAME=menusmart

# Autenticación
JWT_SECRET=changeme
JWT_EXPIRES_IN=3600s

# Servicio Python (FastAPI)
PYTHON_SERVICE_URL=http://localhost:8000

# Actualización de precios (todas opcionales, estos son los valores por defecto)
# Minutos mínimos entre dos actualizaciones exitosas (protege a las tiendas de abuso)
PRICES_MIN_REFRESH_INTERVAL_MINUTES=10
# Horas desde las que un precio se muestra como desactualizado
PRICES_STALE_HOURS=48
# Consultas por llamada al servicio Python (máximo 10)
SCRAPER_BATCH_SIZE=5
SCRAPER_BATCH_TIMEOUT_MS=120000
