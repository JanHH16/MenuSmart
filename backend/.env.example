# Servidor
PORT=3000
NODE_ENV=development

# Base de datos PostgreSQL
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_USER=menusmart
DATABASE_PASSWORD=changeme
DATABASE_NAME=menusmart

# Autenticación
JWT_SECRET=changeme
JWT_EXPIRES_IN=3600s

# Servicio Python (FastAPI)
PYTHON_SERVICE_URL=http://localhost:8000
# Opcionales. Solo hacen falta si el servicio Python es publico (ej. plan gratuito de Render):
# clave compartida que se envia en X-Service-Key (debe coincidir con SERVICE_API_KEY del servicio Python)
# y timeout de las llamadas cortas en ms (un servicio gratuito dormido tarda cerca de 1 minuto en despertar).
# PYTHON_SERVICE_KEY=
# PYTHON_TIMEOUT_MS=60000

# Actualización de precios (todas opcionales, estos son los valores por defecto)
# Minutos mínimos entre dos actualizaciones exitosas (protege a las tiendas de abuso)
PRICES_MIN_REFRESH_INTERVAL_MINUTES=10
# Horas desde las que un precio se muestra como desactualizado
PRICES_STALE_HOURS=48
# Consultas por llamada al servicio Python (máximo 10)
SCRAPER_BATCH_SIZE=5
SCRAPER_BATCH_TIMEOUT_MS=120000

# Límites de solicitudes por IP (todas opcionales, estos son los valores por defecto).
# Cada ruta cuenta aparte. Un valor inválido vuelve al valor por defecto, nunca a "sin límite".
# Los contadores viven en memoria: con varias instancias, cada una cuenta por separado.
# Límite general para todas las rutas
RATE_LIMIT_GLOBAL_MAX=300
RATE_LIMIT_GLOBAL_WINDOW_SECONDS=60
# POST /api/auth/login (frena la fuerza bruta de contraseñas)
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
# POST /api/auth/register (frena la creación masiva de cuentas)
RATE_LIMIT_REGISTER_MAX=5
RATE_LIMIT_REGISTER_WINDOW_SECONDS=60
# POST /api/prices/refresh (cada llamada dispara scraping de las tiendas)
RATE_LIMIT_REFRESH_MAX=5
RATE_LIMIT_REFRESH_WINDOW_SECONDS=60
# Cantidad de proxies de confianza delante del backend (ej. 1 en Render). Sin esto, el límite
# por IP vería la IP del proxy y agruparía a todos los usuarios. No definir si no hay proxy.
# TRUST_PROXY=1
