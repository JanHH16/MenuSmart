# Copiar a terraform.tfvars y completar con valores reales.
# terraform.tfvars NUNCA debe commitearse (ya esta en .gitignore).

render_api_key   = "rnd_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
render_owner_id  = "usr-xxxxxxxxxxxxxxxxxxxx"
environment      = "staging"
region           = "oregon"
repo_url         = "https://github.com/JanHH16/MenuSmart"
branch           = "develop"
jwt_secret       = "changeme"

# "free" (sin costo, los servicios se duermen tras 15 min sin trafico) o "starter" (de pago).
instance_plan = "free"
# Clave compartida backend <-> servicio Python, al menos 24 caracteres aleatorios.
python_service_key = "changeme-una-clave-larga-y-aleatoria"
